		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"@types/sanitize-html": "^2.16.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
