# Copy to .env and fill in. Never commit .env.
# Every variable is declared and validated in src/env.ts.

# ---------------------------------------------------------------------------
# Required at runtime
# ---------------------------------------------------------------------------

# Postgres connection string (Neon). With DATABASE_DRIVER=pglite use pglite://./.pglite
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used by Better Auth to sign sessions and tokens (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me

# Canonical public origin of the site
PUBLIC_SITE_URL=http://localhost:5173

# Stripe secret API key and webhook signing secret
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend API key and sender address for transactional email
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Skyler's Sewing Secrets <hello@example.com>"

# Bunny Stream video library id, API key and embed token authentication key
BUNNY_VIDEO_LIBRARY_ID=123456
BUNNY_VIDEO_API_KEY=xxx
BUNNY_EMBED_TOKEN_KEY=xxx

# Bunny Stream CDN hostname serving thumbnails and previews
BUNNY_STREAM_CDN_HOST=vz-xxx.b-cdn.net

# Public base URL of the Bunny storage pull zone for images
PUBLIC_BUNNY_CDN_URL=https://xxx.b-cdn.net

# Bunny Storage zone name and API key for image uploads
BUNNY_STORAGE_ZONE=xxx
BUNNY_STORAGE_API_KEY=xxx

# Bunny pull zone token authentication key (optional): signs download links; unsigned when empty
BUNNY_CDN_TOKEN_KEY=

# Inbox that receives contact form submissions
CONTACT_EMAIL=hello@example.com

# Bearer secret that authorises Vercel cron requests
CRON_SECRET=change-me

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Google OAuth; Google sign-in is disabled when absent
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry DSN for error reporting; disabled when absent
SENTRY_DSN=
# Sentry DSN for the browser (public, ships in the client bundle); disabled when empty
PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile keys for the contact form; challenge off unless both are set.
# The site key is public: the widget markup carries it to the browser.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel ISR bypass token used to revalidate cached pages on demand
REVALIDATE_BYPASS_TOKEN=

# Database driver: neon (default) in deployment, pglite for local development
DATABASE_DRIVER=neon
