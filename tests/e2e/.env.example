# Browser suite (npx playwright test). Copy to tests/e2e/.env for a local run;
# in CI each value is a repository secret of the same name. The suite targets a
# deployed preview running Stripe in test mode against a Neon branch.

# Origin of the deployment under test, no trailing slash. It must be reachable
# without Vercel deployment protection (the beta domain is).
E2E_BASE_URL=https://beta.skylersewingsecrets.com

# A migrated all-access member (profiles.is_member, a `migration` entitlement).
E2E_MEMBER_EMAIL=member@sewing.local
E2E_MEMBER_PASSWORD=dev-password-123

# An admin with TOTP turned on. The secret is the `secret=` parameter of the
# otpauth:// URI shown when 2FA was enabled. Without it admin-bundle.spec.ts is skipped.
E2E_ADMIN_EMAIL=admin@sewing.local
E2E_ADMIN_PASSWORD=dev-password-123
E2E_ADMIN_TOTP_SECRET=
# Two existing, published lessons with ready video, as admin search terms, comma-separated.
E2E_ADMIN_BUNDLE_LESSONS=Perfect French seams,Invisible zips

# Throwaway buyers: a unique suffix is inserted before the @ for every purchase.
# Resend's delivered@resend.dev sink accepts the receipts without bouncing.
E2E_BUYER_EMAIL_PREFIX=delivered+e2e@resend.dev

# Catalogue the money specs use (defaults are the rows scripts/seed-dev.ts creates).
E2E_SINGLE_SLUG=perfect-french-seams
E2E_BUNDLE_SLUG=finishing-touches
# A lesson the bundle is the cheapest offer for: in the bundle, not sold as a single
# (the lesson page links only the cheapest product containing it and the course).
E2E_BUNDLE_LESSON_PATH=/modules/getting-started/your-first-seam
# A live promo code that applies to the bundle.
E2E_PROMO_CODE=WELCOME10

# Set to 1 when the Stripe CLI is on PATH and STRIPE_API_KEY holds the test-mode
# secret key; refund-revokes.spec.ts is skipped otherwise.
E2E_STRIPE_CLI=
