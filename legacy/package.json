{
	"name": "skyler-sewing-secrets",
	"private": true,
	"version": "0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"test": "vitest run",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"seed": "npx tsx seed/index.ts",
		"seed:modules": "npx tsx seed/index.ts modules",
		"seed:lessons": "npx tsx seed/index.ts lessons",
		"seed:testimonials": "npx tsx seed/index.ts testimonials",
		"seed:faq": "npx tsx seed/index.ts faq",
		"seed:pricing": "npx tsx seed/index.ts pricing",
		"seed:blog": "npx tsx seed/index.ts blog",
		"upload:images": "npx tsx scripts/upload-images.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"migrate:neon": "npx tsx scripts/migrate-to-neon/index.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^22.13.14",
		"@types/pg": "^8.20.0",
		"autoprefixer": "^10.4.21",
		"dotenv": "^17.2.3",
		"drizzle-kit": "^0.31.10",
		"pg": "^8.22.0",
		"postcss": "^8.5.3",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.34.5",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^3.4.17",
		"tsx": "^4.19.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"bcryptjs": "^3.0.3",
