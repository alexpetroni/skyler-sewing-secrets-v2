# =============================================
# PUBLIC VARIABLES (exposed to browser)
# Must start with PUBLIC_ for SvelteKit
# =============================================

PUBLIC_SITE_URL=http://localhost:5173

# =============================================
# PRIVATE VARIABLES (server-side only)
# Never exposed to browser
# =============================================

# Neon Postgres (Vercel Marketplace integration injects this automatically;
# use the pooled connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=xxxxxxxxxx

# Google OAuth (same client as before, from the Google Cloud console;
# add <PUBLIC_SITE_URL>/api/auth/callback/google as an authorized redirect URI)
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxx

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Bunny.net (Image CDN & Video Hosting)
PUBLIC_BUNNY_STORAGE_ZONE=skyler-storage
PUBLIC_BUNNY_CDN_URL=https://skyler-storage.b-cdn.net
BUNNY_API_KEY=<your-bunny-storage-api-key>

# Bunny.net Stream (Video Library)
# Get this from: Stream > Your Library > API > Library API Key
BUNNY_VIDEO_LIBRARY_ID=556030
BUNNY_VIDEO_API_KEY=<your-bunny-video-library-api-key>
# Stream > Library > Security > Embed view token authentication
# Optional: when set, lesson embed URLs are signed server-side (token + expires)
BUNNY_EMBED_TOKEN_KEY=

# Admin Configuration
# First user with this email becomes admin
ADMIN_EMAIL=admin@example.com

# Contact Form
# Where contact form submissions are sent (falls back to ADMIN_EMAIL)
CONTACT_EMAIL=contact@example.com

# =============================================
# ONE-OFF MIGRATION (scripts/migrate-to-neon)
# Direct (non-pooled) connection strings; not needed by the app
# =============================================

# Supabase direct Postgres connection (Dashboard > Settings > Database)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Neon direct connection (DATABASE_URL_UNPOOLED from the Vercel integration)
NEON_DB_URL=postgresql://user:password@host/dbname?sslmode=require
